# Copy to .env (gitignored). API keys stay local.
BASE_URL=https://openrouter.ai/api/v1
BASE_KEY=
MODEL=
MODEL_MODE=tools

# Optional model knobs:
# MODEL_MAX_TOKENS=16384 # default; raise only for very long reasoning models
# MODEL_TEMPERATURE=0.3
# MODEL_REASONING_EFFORT=medium # llama.cpp/Jinja only: off, low, medium, high
# MODEL_NAME=my-label
# LLM_REQUEST_TIMEOUT_MS=300000 # optional; default is 120000
# MODEL_RECOVERY_DELAY_MS=300000 # long retry after short adapter retries fail
# MODEL_RECOVERY_MAX_RETRIES=5   # set 0 to disable long recovery

# Named presets in balatro.config.json read their own keys from env vars, e.g.:
# OPENROUTER_API_KEY=sk-or-...

# Finished games submit to the public Evalatro leaderboard by default.
# SUBMIT=false # opt out entirely (or pass --no-submit)
# SUBMIT_URL=https://your-leaderboard.example # advanced: override public leaderboard
